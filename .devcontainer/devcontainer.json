{
  "name": ".NET Aspire",
  "image": "mcr.microsoft.com/devcontainers/dotnet:9.0-bookworm",

  "features": {
    // Use Docker-in-Docker or Podman-in-Podman if supported
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false,
      "alternativeRuntime": "podman"
    },
    "ghcr.io/devcontainers/features/powershell:1": {}
  },

  "hostRequirements": {
    "cpus": 8,
    "memory": "8gb",
    "storage": "64gb"
  },

  // Post-create and post-start commands
  "onCreateCommand": "curl -sSL https://aspire.dev/install.sh | bash",
  "postStartCommand": "dotnet dev-certs https --trust",

  // VSCode customization
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "GitHub.copilot-chat",
        "GitHub.copilot"
      ],
      "settings": {
        // Prefer Podman if Docker is unavailable
        "dev.containers.dockerPath": "podman"
      }
    }
  },

  "updateContentCommand": "bash .devcontainer/check-container-runtime.sh"

  // "remoteUser": "root"
}
